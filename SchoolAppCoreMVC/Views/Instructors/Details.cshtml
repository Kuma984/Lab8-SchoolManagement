@model SchoolAppCoreMVC.Models.Instructor
@{ ViewData["Title"] = "Instructor Details"; }
<h2>Instructor Details</h2>
<dl class="row">
    <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.InstructorID</dd>
    <dt class="col-sm-3">Last Name</dt><dd class="col-sm-9">@Model.LastName</dd>
    <dt class="col-sm-3">First Name</dt><dd class="col-sm-9">@Model.FirstName</dd>
    <dt class="col-sm-3">Hire Date</dt><dd class="col-sm-9">@Model.HireDate.ToString("yyyy-MM-dd")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.InstructorID" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
