@model SchoolAppCoreMVC.Models.Instructor
@{ ViewData["Title"] = "Edit Instructor"; }
<h2>Edit Instructor</h2>
<form asp-action="Edit">
    <input type="hidden" asp-for="InstructorID" />
    <div class="mb-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /></div>
    <div class="mb-3"><label asp-for="HireDate" class="form-label"></label><input asp-for="HireDate" class="form-control" type="date" /></div>
    <button type="submit" class="btn btn-warning">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
