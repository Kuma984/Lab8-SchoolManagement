@model IEnumerable<SchoolAppCoreMVC.Models.Instructor>
@{ ViewData["Title"] = "Instructors"; }
<h2>Instructors</h2>
<p><a asp-action="Create" class="btn btn-primary btn-sm">+ Create New</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Last Name</th><th>First Name</th><th>Hire Date</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.InstructorID</td>
            <td>@item.LastName</td>
            <td>@item.FirstName</td>
            <td>@item.HireDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.InstructorID" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.InstructorID" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.InstructorID" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
