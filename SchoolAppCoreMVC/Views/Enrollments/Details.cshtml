@model SchoolAppCoreMVC.Models.Enrollment
@{ ViewData["Title"] = "Enrollment Details"; }
<h2>Enrollment Details</h2>
<dl class="row">
    <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.EnrollmentID</dd>
    <dt class="col-sm-3">Course</dt><dd class="col-sm-9">@Model.Course?.Title</dd>
    <dt class="col-sm-3">Student</dt><dd class="col-sm-9">@Model.Student?.FirstName @Model.Student?.LastName</dd>
    <dt class="col-sm-3">Grade</dt><dd class="col-sm-9">@(Model.Grade.HasValue ? Model.Grade.Value.ToString("0.0") : "N/A")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.EnrollmentID" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
