@model IEnumerable<SchoolAppCoreMVC.Models.Enrollment>
@{ ViewData["Title"] = "Enrollments"; }
<h2>Enrollments</h2>
<p><a asp-action="Create" class="btn btn-primary btn-sm">+ Create New</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Course</th><th>Student</th><th>Grade</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.EnrollmentID</td>
            <td>@item.Course?.Title</td>
            <td>@item.Student?.FirstName @item.Student?.LastName</td>
            <td>@(item.Grade.HasValue ? item.Grade.Value.ToString("0.0") : "N/A")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EnrollmentID" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.EnrollmentID" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.EnrollmentID" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
