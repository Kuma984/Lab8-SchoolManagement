@model SchoolAppCoreMVC.Models.Enrollment
@{ ViewData["Title"] = "Create Enrollment"; }
<h2>Create Enrollment</h2>
<form asp-action="Create">
    <div class="mb-3">
        <label class="form-label">Course</label>
        <select asp-for="CourseID" class="form-select" asp-items="ViewBag.CourseID">
            <option value="">-- Select Course --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Student</label>
        <select asp-for="StudentID" class="form-select" asp-items="ViewBag.StudentID">
            <option value="">-- Select Student --</option>
        </select>
    </div>
    <div class="mb-3"><label asp-for="Grade" class="form-label"></label><input asp-for="Grade" class="form-control" type="number" step="0.1" /></div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
