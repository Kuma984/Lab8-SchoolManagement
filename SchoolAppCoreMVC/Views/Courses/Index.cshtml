@model IEnumerable<SchoolAppCoreMVC.Models.Course>
@{ ViewData["Title"] = "Courses"; }
<h2>Courses</h2>
<p><a asp-action="Create" class="btn btn-primary btn-sm">+ Create New</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Title</th><th>Credits</th><th>Department</th><th>Instructor</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.CourseID</td>
            <td>@item.Title</td>
            <td>@item.Credits</td>
            <td>@item.Department?.DepartmentName</td>
            <td>@(item.Instructor != null ? item.Instructor.FirstName + " " + item.Instructor.LastName : "N/A")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CourseID" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.CourseID" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.CourseID" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
