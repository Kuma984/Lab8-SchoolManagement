@model SchoolAppCoreMVC.Models.Department
@{ ViewData["Title"] = "Department Details"; }
<h2>Department Details</h2>
<dl class="row">
    <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.DepartmentID</dd>
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.DepartmentName</dd>
    <dt class="col-sm-3">Budget</dt><dd class="col-sm-9">@Model.Budget.ToString("C")</dd>
    <dt class="col-sm-3">Start Date</dt><dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.DepartmentID" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
