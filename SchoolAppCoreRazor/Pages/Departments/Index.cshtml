@page
@model SchoolAppCoreRazor.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Departments";
}
<h2>Departments</h2>
<p><a asp-page="Create" class="btn btn-primary btn-sm">+ Create New</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Name</th><th>Budget</th><th>Start Date</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var d in Model.Departments)
    {
        <tr>
            <td>@d.DepartmentID</td>
            <td>@d.DepartmentName</td>
            <td>@d.Budget.ToString("C")</td>
            <td>@d.StartDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-page="Edit" asp-route-id="@d.DepartmentID" class="btn btn-sm btn-warning">Edit</a>
                <a asp-page="Details" asp-route-id="@d.DepartmentID" class="btn btn-sm btn-info">Details</a>
                <a asp-page="Delete" asp-route-id="@d.DepartmentID" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
