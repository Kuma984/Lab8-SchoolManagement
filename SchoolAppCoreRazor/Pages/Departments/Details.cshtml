@page "{id:int}"
@model SchoolAppCoreRazor.Pages.Departments.DetailsModel
@{
    ViewData["Title"] = "Department Details";
}
<h2>Department Details</h2>
<dl class="row">
    <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.Department.DepartmentID</dd>
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Department.DepartmentName</dd>
    <dt class="col-sm-3">Budget</dt><dd class="col-sm-9">@Model.Department.Budget.ToString("C")</dd>
    <dt class="col-sm-3">Start Date</dt><dd class="col-sm-9">@Model.Department.StartDate.ToString("yyyy-MM-dd")</dd>
</dl>
<a asp-page="Edit" asp-route-id="@Model.Department.DepartmentID" class="btn btn-warning">Edit</a>
<a asp-page="Index" class="btn btn-secondary">Back</a>
