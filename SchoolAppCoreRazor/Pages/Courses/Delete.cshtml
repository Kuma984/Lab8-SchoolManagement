@page "{id:int}"
@model SchoolAppCoreRazor.Pages.Courses.DeleteModel
@{
    ViewData["Title"] = "Delete Course";
}
<h2>Delete Course</h2>
<p>Are you sure you want to delete course <strong>@Model.Course.Title</strong>?</p>
<form method="post">
    <input type="hidden" asp-for="Course.CourseID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
