@page
@model SchoolAppCoreRazor.Pages.Courses.CreateModel
@{
    ViewData["Title"] = "Create Course";
}
<h2>Create Course</h2>
<form method="post">
    <div class="mb-3"><label class="form-label">Title</label><input asp-for="Course.Title" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Credits</label><input asp-for="Course.Credits" class="form-control" type="number" /></div>
    <div class="mb-3">
        <label class="form-label">Department</label>
        <select asp-for="Course.DepartmentID" asp-items="Model.DepartmentList" class="form-select">
            <option value="">-- Select Department --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Instructor</label>
        <select asp-for="Course.InstructorID" asp-items="Model.InstructorList" class="form-select">
            <option value="">-- Select Instructor --</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
