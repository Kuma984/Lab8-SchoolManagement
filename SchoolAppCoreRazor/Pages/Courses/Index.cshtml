@page
@model SchoolAppCoreRazor.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Courses";
}
<h2>Courses</h2>
<p><a asp-page="Create" class="btn btn-primary btn-sm">+ Create New</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Title</th><th>Credits</th><th>Department</th><th>Instructor</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model.Courses)
    {
        <tr>
            <td>@c.CourseID</td>
            <td>@c.Title</td>
            <td>@c.Credits</td>
            <td>@c.Department?.DepartmentName</td>
            <td>@(c.Instructor != null ? c.Instructor.FirstName + " " + c.Instructor.LastName : "-")</td>
            <td>
                <a asp-page="Edit" asp-route-id="@c.CourseID" class="btn btn-sm btn-warning">Edit</a>
                <a asp-page="Details" asp-route-id="@c.CourseID" class="btn btn-sm btn-info">Details</a>
                <a asp-page="Delete" asp-route-id="@c.CourseID" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
