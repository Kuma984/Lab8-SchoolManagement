@page "{id:int}"
@model SchoolAppCoreRazor.Pages.Courses.DetailsModel
@{
    ViewData["Title"] = "Course Details";
}
<h2>Course Details</h2>
<dl class="row">
    <dt class="col-sm-3">Course ID</dt><dd class="col-sm-9">@Model.Course.CourseID</dd>
    <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Course.Title</dd>
    <dt class="col-sm-3">Credits</dt><dd class="col-sm-9">@Model.Course.Credits</dd>
    <dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Course.Department?.DepartmentName</dd>
    <dt class="col-sm-3">Instructor</dt><dd class="col-sm-9">@(Model.Course.Instructor != null ? Model.Course.Instructor.FirstName + " " + Model.Course.Instructor.LastName : "N/A")</dd>
</dl>
<a asp-page="Edit" asp-route-id="@Model.Course.CourseID" class="btn btn-warning">Edit</a>
<a asp-page="Index" class="btn btn-secondary">Back</a>
