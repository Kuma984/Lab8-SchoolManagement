@page
@model SchoolAppCoreRazor.Pages.Students.IndexModel
@{ ViewData["Title"] = "Students"; }
<h2>Students</h2>
<p><a asp-page="Create" class="btn btn-primary btn-sm">+ Create New</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark"><tr><th>ID</th><th>Last Name</th><th>First Name</th><th>Enrollment Date</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var s in Model.Students)
    {
        <tr>
            <td>@s.StudentID</td><td>@s.LastName</td><td>@s.FirstName</td>
            <td>@s.EnrollmentDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-page="Edit" asp-route-id="@s.StudentID" class="btn btn-sm btn-warning">Edit</a>
                <a asp-page="Details" asp-route-id="@s.StudentID" class="btn btn-sm btn-info">Details</a>
                <a asp-page="Delete" asp-route-id="@s.StudentID" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
