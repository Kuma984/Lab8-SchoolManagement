@page "{id:int}"
@model SchoolAppCoreRazor.Pages.Students.DeleteModel
@{ ViewData["Title"] = "Delete Student"; }
<h2>Delete Student</h2>
<p>Are you sure you want to delete student <strong>@Model.Student.FirstName @Model.Student.LastName</strong>?</p>
<form method="post">
    <input type="hidden" asp-for="Student.StudentID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
