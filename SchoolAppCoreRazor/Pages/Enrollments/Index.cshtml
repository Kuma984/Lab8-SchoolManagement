@page
@model SchoolAppCoreRazor.Pages.Enrollments.IndexModel
@{
    ViewData["Title"] = "Enrollments";
}
<h2>Enrollments</h2>
<p><a asp-page="Create" class="btn btn-primary btn-sm">+ Create New</a></p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>ID</th><th>Course</th><th>Student</th><th>Grade</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var e in Model.Enrollments)
    {
        <tr>
            <td>@e.EnrollmentID</td>
            <td>@e.Course?.Title</td>
            <td>@e.Student?.FirstName @e.Student?.LastName</td>
            <td>@(e.Grade.HasValue ? e.Grade.Value.ToString("0.0") : "N/A")</td>
            <td>
                <a asp-page="Edit" asp-route-id="@e.EnrollmentID" class="btn btn-sm btn-warning">Edit</a>
                <a asp-page="Details" asp-route-id="@e.EnrollmentID" class="btn btn-sm btn-info">Details</a>
                <a asp-page="Delete" asp-route-id="@e.EnrollmentID" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
