@page
@model SchoolAppCoreRazor.Pages.Enrollments.CreateModel
@{
    ViewData["Title"] = "Create Enrollment";
}
<h2>Create Enrollment</h2>
<form method="post">
    <div class="mb-3">
        <label class="form-label">Course</label>
        <select asp-for="Enrollment.CourseID" asp-items="Model.CourseList" class="form-select">
            <option value="">-- Select Course --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Student</label>
        <select asp-for="Enrollment.StudentID" asp-items="Model.StudentList" class="form-select">
            <option value="">-- Select Student --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Grade</label>
        <input asp-for="Enrollment.Grade" class="form-control" type="number" step="0.1" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
