@page "{id:int}"
@model SchoolAppCoreRazor.Pages.Instructors.EditModel
@{
    ViewData["Title"] = "Edit Instructor";
}
<h2>Edit Instructor</h2>
<form method="post">
    <input type="hidden" asp-for="Instructor.InstructorID" />
    <div class="mb-3"><label class="form-label">Last Name</label><input asp-for="Instructor.LastName" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">First Name</label><input asp-for="Instructor.FirstName" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Hire Date</label><input asp-for="Instructor.HireDate" class="form-control" type="date" /></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
